diff --git a/src/plugins/providers.runtime.activation.test.ts b/src/plugins/providers.runtime.activation.test.ts
new file mode 100644
index 00000000..ba989571
--- /dev/null
+++ b/src/plugins/providers.runtime.activation.test.ts
@@ -0,0 +1,178 @@
+/** Protects operation-owned provider activation inputs and their freshness boundaries. */
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { PluginLoadOptions } from "./loader-types.js";
+import { createPluginCache, withPluginCache } from "./plugin-cache.js";
+import { clearPluginMetadataLifecycleCaches } from "./plugin-metadata-lifecycle.js";
+import { createPluginMetadataSnapshotFixture } from "./plugin-metadata.test-support.js";
+import { createProviderRegistryResolver } from "./providers.runtime-core.js";
+import { createEmptyPluginRegistry } from "./registry-empty.js";
+import { resetPluginRuntimeStateForTest } from "./runtime.js";
+
+const mocks = vi.hoisted(() => ({
+  isPluginRegistryLoadInFlight: vi.fn<(options: PluginLoadOptions) => boolean>(() => false),
+  getRuntimePluginRegistryForLoadOptions: vi.fn(),
+}));
+
+const { isPluginProvidersLoadInFlight, resolvePluginProvidersCore } =
+  createProviderRegistryResolver({
+    isPluginRegistryLoadInFlight: mocks.isPluginRegistryLoadInFlight,
+    resolveRuntimePluginRegistry: mocks.getRuntimePluginRegistryForLoadOptions,
+    loadOpenClawPlugins: () => {
+      throw new Error("runtime provider lookup must not activate a plugin registry");
+    },
+  });
+
+function createActivationQuery() {
+  const config: OpenClawConfig = {
+    agents: { defaults: { models: { "bench/model": {} } } },
+    plugins: { entries: { "bench-plugin": {} } },
+    models: {
+      providers: {
+        bench: {
+          api: "openai-completions",
+          baseUrl: "https://models.example.test/v1",
+          models: [],
+        },
+      },
+    },
+  };
+  return {
+    config,
+    env: {},
+    workspaceDir: "/tmp/provider-activation-test",
+    providerRefs: ["bench"],
+    pluginMetadataSnapshot: {
+      ...createPluginMetadataSnapshotFixture({
+        plugins: [
+          {
+            id: "bench-plugin",
+            providers: ["bench"],
+            modelCatalog: { aliases: { "bench-alias": { provider: "bench" } } },
+          },
+          { id: "native-plugin", activation: { onAgentHarnesses: ["native-fixture"] } },
+        ],
+      }),
+      discovery: { candidates: [], diagnostics: [] },
+    },
+  };
+}
+
+function readActivationOptions(query: ReturnType<typeof createActivationQuery>) {
+  isPluginProvidersLoadInFlight(query);
+  const options = mocks.isPluginRegistryLoadInFlight.mock.calls.at(-1)?.[0];
+  if (!options?.activationSourceConfig) {
+    throw new Error("expected provider activation options at the registry boundary");
+  }
+  return options;
+}
+
+beforeEach(() => {
+  clearPluginMetadataLifecycleCaches();
+  resetPluginRuntimeStateForTest();
+  const registry = createEmptyPluginRegistry();
+  registry.providers.push({
+    pluginId: "bench-plugin",
+    provider: { id: "bench", label: "Bench", auth: [] },
+    source: "/plugins/bench/index.js",
+  });
+  mocks.getRuntimePluginRegistryForLoadOptions.mockReturnValue(registry);
+});
+
+afterEach(() => {
+  clearPluginMetadataLifecycleCaches();
+  resetPluginRuntimeStateForTest();
+  vi.clearAllMocks();
+});
+
+describe("provider activation operation ownership", () => {
+  it("shares activation sources between provider preflight and alias lookup only in one operation", () => {
+    const query = createActivationQuery();
+    const first = withPluginCache(createPluginCache(), () => {
+      const preflight = readActivationOptions(query);
+      expect(
+        resolvePluginProvidersCore({ ...query, providerRefs: ["bench-alias"] }).map(
+          (provider) => provider.id,
+        ),
+      ).toEqual(["bench"]);
+      const runtime = mocks.getRuntimePluginRegistryForLoadOptions.mock.calls.at(-1)?.[0];
+      expect(runtime?.activationSourceConfig).toBe(preflight.activationSourceConfig);
+      return preflight.activationSourceConfig;
+    });
+    const next = withPluginCache(createPluginCache(), () => readActivationOptions(query));
+    expect(next.activationSourceConfig).not.toBe(first);
+  });
+
+  it("keeps distinct config objects and process-scoped calls independent", () => {
+    const query = createActivationQuery();
+    withPluginCache(createPluginCache(), () => {
+      const first = readActivationOptions(query);
+      const second = readActivationOptions({ ...query, config: { ...query.config } });
+      expect(second.activationSourceConfig).not.toBe(first.activationSourceConfig);
+    });
+    withPluginCache(createPluginCache({ kind: "process" }), () => {
+      const first = readActivationOptions(query);
+      expect(readActivationOptions(query).activationSourceConfig).not.toBe(
+        first.activationSourceConfig,
+      );
+    });
+  });
+
+  it("retains the authored config when its owner is already enabled and allowlisted", () => {
+    const query = createActivationQuery();
+    query.config.plugins = {
+      allow: ["bench-plugin"],
+      entries: { "bench-plugin": { enabled: true } },
+    };
+    for (const kind of ["operation", "process"] as const) {
+      withPluginCache(createPluginCache({ kind }), () => {
+        expect(readActivationOptions(query).activationSourceConfig).toBe(query.config);
+      });
+    }
+  });
+
+  it("refreshes copied config fields and plugin enablement during one operation", () => {
+    const query = createActivationQuery();
+    withPluginCache(createPluginCache(), () => {
+      const first = readActivationOptions(query);
+      query.config.agents = { defaults: { models: { "bench/model": { alias: "Changed" } } } };
+      query.config.auth = { profiles: {} };
+      const replaced = readActivationOptions(query);
+      expect(replaced.activationSourceConfig).not.toBe(first.activationSourceConfig);
+      expect(replaced.activationSourceConfig?.agents).toBe(query.config.agents);
+      expect(replaced.activationSourceConfig?.auth).toBe(query.config.auth);
+
+      query.config.plugins!.entries!["bench-plugin"]!.config = { endpoint: "changed" };
+      const pluginChanged = readActivationOptions(query);
+      expect(pluginChanged.activationSourceConfig).not.toBe(replaced.activationSourceConfig);
+      expect(
+        pluginChanged.activationSourceConfig?.plugins?.entries?.["bench-plugin"]?.config,
+      ).toEqual({ endpoint: "changed" });
+
+      query.config.plugins!.entries!["bench-plugin"]!.enabled = false;
+      const disabled = readActivationOptions(query);
+      expect(disabled.onlyPluginIds).toEqual([]);
+      expect(disabled.config?.plugins?.entries?.["bench-plugin"]?.enabled).toBe(false);
+    });
+  });
+
+  it("refreshes derived harness activation after nested config mutation and lifecycle retirement", () => {
+    const query = createActivationQuery();
+    withPluginCache(createPluginCache(), () => {
+      const first = readActivationOptions(query);
+      expect(first.config?.plugins?.entries?.["native-plugin"]).toBeUndefined();
+
+      query.config.agents!.defaults!.models!["bench/model"]!.agentRuntime = {
+        id: "native-fixture",
+      };
+      clearPluginMetadataLifecycleCaches();
+      const refreshed = readActivationOptions(query);
+
+      expect(refreshed.activationSourceConfig).not.toBe(first.activationSourceConfig);
+      expect(refreshed.config?.plugins?.entries?.["native-plugin"]?.enabled).toBe(true);
+      expect(refreshed.autoEnabledReasons?.["native-plugin"]).toContain(
+        "native-fixture agent runtime configured",
+      );
+    });
+  });
+});
