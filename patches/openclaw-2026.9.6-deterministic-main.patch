+import { createPluginMetadataSnapshotFixture } from "./plugin-metadata.test-support.js";
+import * as publicSurfaceLoader from "./public-surface-loader.js";
+
+const temporary = useAutoCleanupTempDirTracker(afterEach);
+afterEach(() => vi.restoreAllMocks());
+
+function fixture() {
+  const bundled = temporary.make("provider-policy-catalog-");
+  for (const id of ["first", "second"]) {
+    const root = path.join(bundled, id);
+    fs.mkdirSync(root);
+    fs.writeFileSync(path.join(root, "package.json"), JSON.stringify({ name: id, type: "module" }));
+    fs.writeFileSync(
+      path.join(root, "provider-policy-api.js"),
+      `export const normalizeModelCatalogId = ({ modelId }) => ${JSON.stringify(id + ":")} + modelId;`,
+    );
+  }
+  return {
+    env: { OPENCLAW_BUNDLED_PLUGINS_DIR: bundled, OPENCLAW_TEST_TRUST_BUNDLED_PLUGINS_DIR: "1" },
+    snapshot: (id?: string) =>
+      createPluginMetadataSnapshotFixture({
+        plugins: id
+          ? [{ id, rootDir: path.join(bundled, id), providers: ["fixture-provider"] }]
+          : [],
+      }),
+  };
+}
+
+describe("catalog identity policy preparation", () => {
+  const identity = (id: string, provider = "fixture-provider") =>
+    JSON.parse(resolveModelCatalogIdentityKey({ provider, id }));
+
+  it("prepares each provider once across distinct catalog rows without caching model hooks", () => {
+    const setup = fixture();
+    const original = setup.snapshot("first");
+    const inventory = vi.fn(() => original.plugins);
+    const snapshot = {
+      ...original,
+      get plugins() {
+        return inventory();
+      },
+    };
+    const artifacts = vi.spyOn(
+      publicSurfaceLoader,
+      "loadBundledPluginPublicArtifactModuleFromCandidatesSync",
+    );
+    withEnv(setup.env, () =>
+      withPluginCache(createPluginCache(), () =>
+        withPluginMetadataSnapshotScope(finalizePluginMetadataSnapshot(snapshot), () => {
+          expect(identity("warm")).toEqual(["fixture-provider", "first:warm"]);
+          expect(identity("warm", "missing-provider")).toEqual(["missing-provider", "warm"]);
+          const reads = inventory.mock.calls.length;
+          const loads = artifacts.mock.calls.length;
+          for (let i = 0; i < 200; i += 1) {
+            expect(identity(`model-${i}`)).toEqual(["fixture-provider", `first:model-${i}`]);
+            expect(identity(`model-${i}`, "missing-provider")).toEqual([
+              "missing-provider",
+              `model-${i}`,
+            ]);
+          }
+          expect(inventory).toHaveBeenCalledTimes(reads);
+          expect(artifacts).toHaveBeenCalledTimes(loads);
+        }),
+      ),
+    );
+  });
+
+  it("keeps empty views separate and observes changed owners in a new generation", () => {
+    const setup = fixture();
+    const owner = createPluginCache();
+    const { first, empty } = withPluginCache(owner, () => ({
+      first: setup.snapshot("first"),
+      empty: setup.snapshot(),
+    }));
+    withEnv(setup.env, () => {
+      withPluginCache(owner, () => {
+        withPluginMetadataSnapshotScope(empty, () =>
+          expect(identity("demo")).toEqual(["fixture-provider", "demo"]),
+        );
+        withPluginMetadataSnapshotScope(first, () =>
+          expect(identity("demo")).toEqual(["fixture-provider", "first:demo"]),
+        );
+        withPluginMetadataSnapshotScope(empty, () =>
+          expect(identity("demo")).toEqual(["fixture-provider", "demo"]),
+        );
+      });
+      withPluginCache(createPluginCache(), () =>
+        withPluginMetadataSnapshotScope(setup.snapshot("second"), () =>
+          expect(identity("demo")).toEqual(["fixture-provider", "second:demo"]),
+        ),
+      );
+      withPluginCache(owner, () =>
+        withPluginMetadataSnapshotScope(first, () =>
+          expect(identity("demo")).toEqual(["fixture-provider", "first:demo"]),
+        ),
+      );
+    });
+  });
+
+  it("invalidates cached hits and misses when bundled discovery is disabled and restored", () => {
+    const setup = fixture();
+    withEnv(setup.env, () =>
+      withPluginCache(createPluginCache(), () =>
+        withPluginMetadataSnapshotScope(setup.snapshot("first"), () => {
+          expect(identity("demo")).toEqual(["fixture-provider", "first:demo"]);
+          expect(identity("demo", "first")).toEqual(["first", "first:demo"]);
+          withEnv({ OPENCLAW_DISABLE_BUNDLED_PLUGINS: "1" }, () => {
+            expect(identity("demo")).toEqual(["fixture-provider", "demo"]);
+            expect(identity("demo", "first")).toEqual(["first", "demo"]);
+          });
+          expect(identity("demo")).toEqual(["fixture-provider", "first:demo"]);
+          expect(identity("demo", "first")).toEqual(["first", "first:demo"]);
+        }),
+      ),
+    );
+  });
+});
