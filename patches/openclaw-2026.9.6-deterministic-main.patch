diff --git a/src/commands/models/list.rows.activation.test.ts b/src/commands/models/list.rows.activation.test.ts
new file mode 100644
index 00000000..8cf1257d
--- /dev/null
+++ b/src/commands/models/list.rows.activation.test.ts
@@ -0,0 +1,303 @@
+/** Keeps published model-list reads free of runtime activation and repeated policy scans. */
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { ModelsListParams } from "../../../packages/gateway-protocol/src/schema/agents-models-skills.js";
+import * as modelAuth from "../../agents/model-auth-availability.js";
+import type { ModelCatalogEntry, ModelCatalogSnapshot } from "../../agents/model-catalog.types.js";
+import * as runtimeConfig from "../../config/config.js";
+import type { AgentModelEntryConfig } from "../../config/types.agent-defaults.js";
+import type { ModelDefinitionConfig, ModelProviderConfig } from "../../config/types.models.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import * as gateway from "../../gateway/call.js";
+import {
+  buildModelsListResult,
+  createGatewayAgentModelCatalogProjector,
+} from "../../gateway/server-methods/models-list-result.js";
+import type { GatewayRequestContext } from "../../gateway/server-methods/types.js";
+import { withPluginMetadataSnapshotScope } from "../../plugins/current-plugin-metadata-snapshot.js";
+import { createPluginCache, withPluginCache } from "../../plugins/plugin-cache.js";
+import { clearPluginMetadataLifecycleCaches } from "../../plugins/plugin-metadata-lifecycle.js";
+import { finalizePluginMetadataSnapshot } from "../../plugins/plugin-metadata-snapshot.js";
+import { createPluginMetadataSnapshotFixture } from "../../plugins/plugin-metadata.test-support.js";
+import { createEmptyPluginRegistry } from "../../plugins/registry-empty.js";
+import { resetPluginRuntimeStateForTest } from "../../plugins/runtime.js";
+import type { ProviderPlugin } from "../../plugins/types.js";
+import { modelsListCommand } from "./list.list-command.js";
+import type { ModelRow } from "./list.types.js";
+
+const mocks = vi.hoisted(() => ({
+  getRuntimePluginRegistryForLoadOptions: vi.fn(),
+}));
+
+// Published catalog reads must not materialize runtime providers. The separate
+// provider activation tests cover preparation and operation-cache freshness.
+vi.mock("../../plugins/providers.runtime.js", async () => {
+  const { createProviderRegistryResolver } =
+    await import("../../plugins/providers.runtime-core.js");
+  return createProviderRegistryResolver({
+    resolveRuntimePluginRegistry: mocks.getRuntimePluginRegistryForLoadOptions,
+    isPluginRegistryLoadInFlight: () => false,
+    loadOpenClawPlugins: () => {
+      throw new Error("model-list projection must not activate a plugin registry");
+    },
+  });
+});
+
+vi.mock("../../plugins/provider-hook-runtime.js", async () => {
+  const { createProviderHookRuntime } = await import("../../plugins/provider-hook-runtime-core.js");
+  const providers = await import("../../plugins/providers.runtime.js");
+  return createProviderHookRuntime(providers);
+});
+
+vi.mock("../../plugins/provider-public-artifacts.js", () => ({
+  resolveBundledProviderPolicySurface: () => null,
+  resolveProviderPolicySurface: () => null,
+}));
+
+type ListView = {
+  name: string;
+  all: boolean;
+  sourceProvider: string;
+  providerFilter?: string;
+  replace?: boolean;
+};
+
+function createConfiguredModel(id: string): ModelDefinitionConfig {
+  return {
+    id,
+    name: `Authored ${id}`,
+    input: ["text", "image"],
+    reasoning: false,
+    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+    contextWindow: 64_000,
+    maxTokens: 4096,
+  };
+}
+
+async function renderConfiguredRows(modelCount: number, view: ListView, includeDiscovery: boolean) {
+  clearPluginMetadataLifecycleCaches();
+  resetPluginRuntimeStateForTest();
+  let policyMapScans = 0;
+  const models = Array.from({ length: modelCount }, (_, index) =>
+    createConfiguredModel(`model-${index}`),
+  );
+  const modelEntries = new Proxy<Record<string, AgentModelEntryConfig>>(
+    Object.fromEntries(
+      models.map((model, index) => [
+        `${view.sourceProvider}/${model.id}`,
+        index === 0 ? { alias: "Primary" } : {},
+      ]),
+    ),
+    {
+      ownKeys(target) {
+        policyMapScans += 1;
+        return Reflect.ownKeys(target);
+      },
+    },
+  );
+  const providerConfig: ModelProviderConfig = {
+    api: "openai-completions",
+    baseUrl: "https://models.example.test/v1",
+    models,
+  };
+  const cfg: OpenClawConfig = {
+    agents: {
+      defaults: {
+        model: {
+          primary: `${view.sourceProvider}/model-0`,
+          fallbacks: [`${view.sourceProvider}/model-1`],
+        },
+        models: modelEntries,
+      },
+    },
+    models: {
+      mode: view.replace ? "replace" : "merge",
+      providers: {
+        [view.sourceProvider]: providerConfig,
+        other: { ...providerConfig, models: [createConfiguredModel("other-model")] },
+      },
+    },
+  };
+  const operation = createPluginCache();
+  const metadataSnapshot = withPluginCache(operation, () =>
+    finalizePluginMetadataSnapshot({
+      ...createPluginMetadataSnapshotFixture({
+        plugins: [
+          {
+            id: "bench-plugin",
+            providers: ["bench"],
+            modelCatalog: { aliases: { "bench-alias": { provider: "bench" } } },
+          },
+          { id: "other-plugin", providers: ["other"] },
+        ],
+      }),
+      ...(includeDiscovery ? { discovery: { candidates: [], diagnostics: [] } } : {}),
+    }),
+  );
+  const registry = createEmptyPluginRegistry();
+  const normalizeResolvedModel = vi.fn(() => {
+    throw new Error("Published rows must not repeat runtime model normalization");
+  });
+  for (const providerId of ["bench", "other"]) {
+    const provider: ProviderPlugin = {
+      id: providerId,
+      label: providerId,
+      aliases: providerId === "bench" ? ["bench-alias"] : [],
+      auth: [],
+      normalizeResolvedModel,
+    };
+    registry.providers.push({
+      pluginId: `${providerId}-plugin`,
+      provider,
+      source: `/plugins/${providerId}/index.js`,
+    });
+  }
+  mocks.getRuntimePluginRegistryForLoadOptions.mockReturnValue(registry);
+  // The published owner already holds normalized runtime facts; list reads must
+  // preserve them without running normalizeResolvedModel again for every row.
+  const entries: ModelCatalogEntry[] = [
+    ...models.map((model, providerOrder) => ({
+      ...model,
+      provider: "bench",
+      providerOrder,
+      api: providerConfig.api,
+      baseUrl: providerConfig.baseUrl,
+      contextTokens: 32_000,
+    })),
+    {
+      ...createConfiguredModel("other-model"),
+      provider: "other",
+      providerOrder: 0,
+      api: providerConfig.api,
+      baseUrl: providerConfig.baseUrl,
+      contextTokens: 32_000,
+    },
+  ];
+  const snapshot: ModelCatalogSnapshot = { entries, routeVariants: entries };
+  const evaluateModelAuth = vi.fn(() => ({ availability: true, routeResolution: null }));
+  vi.spyOn(modelAuth, "createModelAuthAvailabilityResolver").mockReturnValue({
+    evaluateRuntimeModelAuth: evaluateModelAuth,
+    evaluateModelAuth,
+    providerDiscoveryProviderIds: [],
+    resolveProviderAuthAvailability: () => true,
+    hasSyntheticAuth: () => false,
+  });
+  vi.spyOn(runtimeConfig, "getRuntimeConfig").mockReturnValue(cfg);
+  vi.spyOn(gateway, "isImplicitLocalGatewayTarget").mockResolvedValue(false);
+  const context = {
+    getRuntimeConfig: () => cfg,
+    loadGatewayModelCatalogSnapshot: vi.fn(() => {
+      throw new Error("Published projection must not discover a second catalog");
+    }),
+    logGateway: { debug: vi.fn() },
+  } as unknown as GatewayRequestContext;
+  const projector = createGatewayAgentModelCatalogProjector({
+    cfg,
+    agentId: "main",
+    snapshot,
+    metadataSnapshot,
+    preparedAuthStore: { version: 1, profiles: {} },
+    pluginRegistry: registry,
+    isCurrent: () => true,
+  });
+  vi.spyOn(gateway, "callGateway").mockImplementation(
+    async <T>(request: Parameters<typeof gateway.callGateway>[0]) =>
+      (await buildModelsListResult({
+        source: { kind: "gateway", context },
+        agentId: "main",
+        params: request.params as ModelsListParams,
+        preloadedCatalog: { agentId: "main", config: cfg, snapshot },
+        preloadedOnly: true,
+        catalogProjector: projector,
+      })) as T,
+  );
+  const runtime = {
+    log: vi.fn(),
+    error: vi.fn(),
+    exit: vi.fn(),
+    writeJson: vi.fn(),
+    writeStdout: vi.fn(),
+  };
+  mocks.getRuntimePluginRegistryForLoadOptions.mockClear();
+  await withPluginCache(operation, () =>
+    withPluginMetadataSnapshotScope(
+      metadataSnapshot,
+      () =>
+        modelsListCommand({ all: view.all, provider: view.providerFilter, json: true }, runtime),
+      { trustConfigIdentity: true },
+    ),
+  );
+  expect(runtime.writeJson).toHaveBeenCalledOnce();
+  const rows = runtime.writeJson.mock.calls[0]![0].models as ModelRow[];
+  expect(gateway.callGateway).toHaveBeenCalledWith(
+    expect.objectContaining({
+      method: "models.list",
+      params: expect.objectContaining({
+        view: view.all || view.providerFilter ? "all" : "default",
+        includeDetails: true,
+        ...(view.providerFilter ? { provider: view.providerFilter } : {}),
+      }),
+    }),
+  );
+  expect(mocks.getRuntimePluginRegistryForLoadOptions).not.toHaveBeenCalled();
+  expect(normalizeResolvedModel).not.toHaveBeenCalled();
+
+  const expectedKeys = models.map((model) => `bench/${model.id}`);
+  // Default lists agent-configured refs; --all also includes provider inventory.
+  if (view.all && !view.providerFilter) {
+    expectedKeys.push("other/other-model");
+  }
+  expect(rows.map((row) => row.key)).toEqual(expectedKeys);
+  expect(rows).toEqual(
+    expectedKeys.map((key) =>
+      expect.objectContaining({
+        name: `Authored ${key.split("/")[1]}`,
+        input: "text+image",
+        contextWindow: 64_000,
+        contextTokens: 32_000,
+        available: true,
+      }),
+    ),
+  );
+  expect(rows[0]?.tags).toEqual(["default", "configured", "alias:Primary"]);
+  expect(rows[1]?.tags).toEqual(["fallback#1", "configured"]);
+  if (view.replace) {
+    expect(evaluateModelAuth).toHaveBeenCalledWith(
+      "bench",
+      expect.objectContaining({ modelId: "model-0" }),
+    );
+  }
+  vi.restoreAllMocks();
+  return policyMapScans;
+}
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  clearPluginMetadataLifecycleCaches();
+  resetPluginRuntimeStateForTest();
+  vi.clearAllMocks();
+});
+
+describe.each([
+  { name: "complete metadata", includeDiscovery: true },
+  { name: "manifest-only metadata", includeDiscovery: false },
+])("configured model-list activation fanout with $name", ({ includeDiscovery }) => {
+  it.each<ListView>([
+    { name: "default", all: false, sourceProvider: "bench" },
+    { name: "all", all: true, sourceProvider: "bench" },
+    {
+      name: "provider alias",
+      all: true,
+      sourceProvider: "bench-alias",
+      providerFilter: "bench-alias",
+      replace: true,
+    },
+  ])("bounds repeated model-policy scans while preserving the $name view", async (view) => {
+    const small = await renderConfiguredRows(4, view, includeDiscovery);
+    const large = await renderConfiguredRows(16, view, includeDiscovery);
+
+    expect(small).toBeGreaterThan(0);
+    // Four times as many refs may enlarge policy preparation, but must not
+    // multiply its scans by the number of rows sharing the same provider owner.
+    expect(large).toBeLessThanOrEqual(small * 5);
+  });
+});
